DATABASE_URL=postgresql://username:password@host:5432/database
PORT=3000

# ── FinCore Assistant (AI chatbot) ─────────────────────────────
# Master switch — the assistant is OFF unless this is exactly "true".
ASSISTANT_ENABLED=false
# "anthropic" (real Claude model) or "mock" (deterministic, no key, used in CI)
ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
# Keeps feature flag + usage separate when environments share one database (local | ci | sit)
ASSISTANT_ENV=default
# Budget guard-rails
ASSISTANT_DAILY_LIMIT=200
ASSISTANT_MAX_TURNS=20
ASSISTANT_MAX_MESSAGE_LENGTH=1000
ASSISTANT_MAX_OUTPUT_TOKENS=600
